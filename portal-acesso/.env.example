# Modo: observar (não barra ninguém, só registra) | bloquear (aplica permissões)
ACESSO_MODO=observar
ACESSO_SESSAO_HORAS=12
ACESSO_COOKIE_SEGURO=0
ACESSO_PORTA=8093

# Integração com Supabase (base de crachás corporativos)
# Preencha no seu servidor com as credenciais reais no arquivo .env
ACESSO_SUPABASE_URL=https://seu-projeto.supabase.co
ACESSO_SUPABASE_CHAVE=sua_chave_service_role_ou_anon_aqui
